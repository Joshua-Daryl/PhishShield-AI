# PhishShield AI Configuration
# Salin file ini menjadi .env jika diperlukan

# Kunci rahasia sesi Flask (Ganti dengan string acak panjang di production)
SECRET_KEY=ganti-dengan-secret-key-acak-anda-yang-aman

# Host & Port untuk menjalankan server
HOST=0.0.0.0
PORT=5000

# Mode aplikasi
FLASK_DEBUG=false

# Opsional: Path kustom untuk database SQLite jika diletakkan di luar root aplikasi
# DATABASE_PATH=/home/username/phishshield.db

# Opsional: Kredensial default admin saat inisialisasi awal
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Keamanan Cookie (Aktifkan 'true' jika domain Anda sudah menggunakan HTTPS)
SESSION_COOKIE_SECURE=false
